<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio en Android < 12: símbolo en el centro y logotipo abajo.
     En Android 12+ la dibuja el sistema (values-v31/styles.xml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fons" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_simbol" />
    </item>
    <item android:bottom="48dp">
        <bitmap android:gravity="bottom|center_horizontal" android:src="@drawable/splash_marca" />
    </item>
</layer-list>
