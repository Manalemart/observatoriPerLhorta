<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: la pantalla de inicio la dibuja el sistema con estos elementos -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_fons</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icona</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_marca</item>
        <item name="android:windowBackground">@color/splash_fons</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_fons</item>
    </style>
</resources>
